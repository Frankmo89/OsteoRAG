# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role: solo para scripts/ingest.ts (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible API (embeddings + chat)
OPENAI_API_KEY=sk-your-key
# Opcional: proxy / Azure / vLLM / etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelos
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Dimensión del embedding — debe coincidir con vector(N) en la migración (por defecto 1536)
EMBEDDING_DIM=1536

# Ingest
CORPUS_DIR=./corpus
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
