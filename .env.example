# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role: solo para scripts/ingest.ts (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible API (embeddings + chat)
OPENAI_API_KEY=sk-your-key
# Opcional: proxy / Azure / vLLM / etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelos
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Dimensión del embedding — debe coincidir con vector(N) en la migración (por defecto 1536)
EMBEDDING_DIM=1536

# Ingest / retrieve
CORPUS_DIR=./corpus
# Chunking ligeramente mayor mejora contexto anatómico; overlap ~20%
CHUNK_SIZE=1200
CHUNK_OVERLAP=250
TOP_K=6
# Umbral mínimo de similitud coseno (0–1). Por debajo → sin citas / not-found
MIN_SIMILARITY=0.32

# OCR para PDFs escaneados (sin texto extraíble)
# auto = tesseract si existe, si no openai; tesseract | openai | off
# Rasterize: pdftoppm si está en PATH; si no, pdfjs-dist + @napi-rs/canvas (sin poppler)
OCR_MODE=auto
# Máx. páginas a OCR por archivo (visión OpenAI tiene coste)
OCR_MAX_PAGES=40
# Modelo visión para OCR_MODE=openai (por defecto = CHAT_MODEL)
# OCR_CHAT_MODEL=gpt-4o-mini

# Auth HTTP Basic (Cloudflare secrets). Vacío = público.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Historial de chats en Supabase (owner compartido hasta Auth)
# Opcional en Worker: wrangler secret / vars. Default: katya
CHAT_OWNER_ID=katya

